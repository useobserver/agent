{
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "auth_mode": {
      "default": "metadata",
      "type": "string",
      "enum": [
        "metadata",
        "service_account_key"
      ]
    },
    "credentials_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "timeout_ms": {
      "default": 10000,
      "type": "integer",
      "minimum": 1000,
      "maximum": 30000
    }
  },
  "required": [
    "project_id",
    "query"
  ],
  "additionalProperties": false
}
