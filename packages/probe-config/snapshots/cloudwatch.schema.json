{
  "type": "object",
  "properties": {
    "region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9-]+$"
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "metric_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "dimensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 255
      }
    },
    "statistic": {
      "default": "Average",
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "period_seconds": {
      "default": 60,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "role_arn": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2048,
      "pattern": "^arn:aws[a-zA-Z-]*:iam::\\d{12}:role\\/[\\w+=,.@/-]+$"
    },
    "external_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 1224
    }
  },
  "required": [
    "region",
    "namespace",
    "metric_name"
  ],
  "additionalProperties": false
}
