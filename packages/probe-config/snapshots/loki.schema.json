{
  "type": "object",
  "properties": {
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "auth_mode": {
      "default": "none",
      "type": "string",
      "enum": [
        "none",
        "bearer",
        "basic"
      ]
    },
    "token_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "username": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "password_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "timeout_ms": {
      "default": 10000,
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    }
  },
  "required": [
    "base_url",
    "query"
  ],
  "additionalProperties": false
}
