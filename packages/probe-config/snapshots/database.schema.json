{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "postgres",
        "mysql",
        "redis",
        "mongodb"
      ]
    },
    "connection_string_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "statement_timeout_ms": {
      "default": 5000,
      "type": "integer",
      "minimum": 100,
      "maximum": 30000
    }
  },
  "required": [
    "kind",
    "connection_string_ref",
    "query"
  ],
  "additionalProperties": false
}
