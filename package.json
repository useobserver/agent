{
  "name": "observer-agent",
  "version": "1.6.1",
  "description": "Observer agent: probes metric sources, pushes results to Observer Cloud.",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "bun --bun tsc --noEmit -p tsconfig.json",
    "build:binary": "bun run scripts/build-binary.mjs",
    "build:binaries": "bun run scripts/build-binary.mjs --all"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1146.0",
    "@aws-sdk/client-sts": "^3.1146.0",
    "@aws-sdk/credential-providers": "^3.1146.0",
    "@grpc/grpc-js": "^1.14.5",
    "@observer/probe-config": "workspace:*",
    "@observer/protocol": "workspace:*",
    "ioredis": "^6.0.0",
    "jsonpath-plus": "^11.1.1",
    "mongodb": "^6.21.0",
    "mysql2": "^3.24.5",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@observer/tsconfig": "workspace:*",
    "@types/bun": "~1.3.14",
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
