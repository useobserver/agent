{
  "name": "observer-agent",
  "version": "1.2.0",
  "description": "Observer agent: probes metric sources, pushes results to Observer Cloud.",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "bun --bun tsc --noEmit -p tsconfig.json",
    "build:binary": "bun run scripts/build-binary.mjs",
    "build:binaries": "bun run scripts/build-binary.mjs --all"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.726.1",
    "@aws-sdk/client-sts": "^3.726.1",
    "@aws-sdk/credential-providers": "^3.726.1",
    "@grpc/grpc-js": "^1.12.0",
    "@observer/probe-config": "workspace:*",
    "@observer/protocol": "workspace:*",
    "ioredis": "^5.4.2",
    "jsonpath-plus": "^10.3.0",
    "mongodb": "^6.12.0",
    "mysql2": "^3.11.5",
    "postgres": "^3.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@observer/tsconfig": "workspace:*",
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
